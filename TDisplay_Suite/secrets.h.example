// Copy to secrets.h (kept out of git) to build in your own defaults. Everything here can
// also be set from a phone on the TDisplay-Setup hotspot, and what is set there wins.
#pragma once
#define HOME_SSID          "your-wifi"            // tried when the phone-set network is not in range
#define HOME_PASS          "your-password"
#define DEFAULT_GXL_SERVER "http://10.0.0.5:8000"  // GXL Event Server, for GXL Firewall
#define DEFAULT_GXL_KEY    ""                      // the event's agent key
#define DEFAULT_CALLSIGN   "N0CALL"
#define DEFAULT_SHELLY     ""                      // a Shelly temp sensor IP, e.g. "10.2.1.60" (Weather Clock)
#define DEFAULT_SWITCHES   ""                      // Port Map switches, e.g. "Core=10.0.0.2,Stage=10.0.0.3"
#define DEFAULT_COMMUNITY  "public"                // Port Map SNMP v2c read community
#define DEFAULT_APP_NAME   "Big Clock"            // the app at first power-on, by its menu name
